#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
ROOT=$(readlink -f "$initscript")
ROOT=${ROOT%/scripts/routerlite.init}
case "$ROOT" in /data/routerlite|/overlay/routerlite) :;; *) return 1;; esac
start_service() {
    procd_open_instance
    procd_set_param command "$ROOT/scripts/run.sh"
    procd_set_param env SSL_CERT_FILE="$ROOT/assets/ca-certificates.crt" GOGC=50 GOMEMLIMIT=24MiB GOMAXPROCS=2
    procd_set_param respawn 3600 10 5
    procd_set_param term_timeout 20
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_close_instance
}
stop_service() {
    RPL_DATA="$ROOT/state" /bin/sh "$ROOT/scripts/network.sh" stop
}
